{
  "expo": {
    "name": "Orchard Shift",
    "slug": "orchard-shift",
    "scheme": "onspaceapp",
    "version": "1.0.0",
    "icon": "./assets/orchard-icon.jpg",
    "ios": { "supportsTablet": true, "infoPlist": { "ITSAppUsesNonExemptEncryption": false } },
    "android": { "permissions": [], "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.CAMERA", "android.permission.ACCESS_FINE_LOCATION", "android.permission.ACCESS_COARSE_LOCATION", "android.permission.READ_CONTACTS", "android.permission.READ_MEDIA_IMAGES", "android.permission.READ_MEDIA_VIDEO", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"] },
    "orientation": "default",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "./plugins/withStorePurchases"],
    "web": { "bundler": "metro" },
    "experiments": { "typedRoutes": true }
  }
}
